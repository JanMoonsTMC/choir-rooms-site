# Settings for every production build (the live site and the previews on Vercel). Not secret, so it is
# committed; secrets stay in Vercel's settings and in .env.local.
#
# Analytics: Vercel Web Analytics, page views only, no cookies (docs/decisions/analytics.md). It records
# only while Analytics is switched on for this project in the Vercel dashboard (it is: checked on 18 October 2026).
NEXT_PUBLIC_ANALYTICS=vercel
#
# Chat: the tawk.to chat window on every public page (docs/decisions/integration.md). Any other value, or
# none, leaves it out. The browser checks' browser cannot reach tawk.to (playwright.config.ts), so they
# never wait on it.
NEXT_PUBLIC_CHAT=tawk
